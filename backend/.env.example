# ==============================================================================
# Kisan Setu - Environment Configuration Template (.env.example)
# ==============================================================================

# Application Metadata
APP_NAME="Kisan Setu"
APP_VERSION="1.0.0"
DEBUG=False

# Database Configuration
# SQLite for local development; use postgresql+psycopg://user:pass@host:5432/db for production
DATABASE_URL="sqlite:///./kisan_setu.db"

# Security & Authentication
# IMPORTANT: Generate a secure secret in production using: openssl rand -hex 32
SECRET_KEY="kisan-setu-dev-insecure-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Allowed Origins (JSON array string)
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Credit & Risk Engine Defaults
CREDIT_COST_RATIO=0.40
MAX_CONSENT_GRANTS=20